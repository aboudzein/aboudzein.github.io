---
import { SITE } from '../consts';
const path = Astro.url.pathname;
const links = [
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <a class="site-name" href="/">{SITE.title}</a>
  <nav aria-label="Main">
    {
      links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <button id="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
          d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path></svg
      >
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path
          d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"></path></svg
      >
    </button>
  </nav>
</header>

<script>
  const button = document.getElementById('theme-toggle');
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
